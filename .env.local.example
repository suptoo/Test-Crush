# TestCrush AI - API Configuration
# Copy this file to .env.local and add your actual API keys

# Qwen AI - For video and audio processing
# Get your key from: https://www.qwen.ai
QWEN_API_KEY=0

# Google Gemini - For PDF analysis and deep search
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=0

# Mistral AI - For text processing
# Get your key from: https://console.mistral.ai
MISTRAL_API_KEY=0

# OpenAI (ChatGPT) - For complex reasoning
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=0

# Perplexity AI - For web search
# Get your key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=0

# Anthropic (Claude) - For advanced analysis
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=0

# Note: Set any key to '0' to use simulated responses for development
# The app will work with simulated AI responses until real API keys are added
